APP_ENV=local
LOG_LEVEL=debug
# Local-only convenience URL. Do not use DATABASE_URL as a cloud runtime secret.
DATABASE_URL=postgres://postgres@localhost:5432/platform_blueprint?sslmode=disable
# Cloud/runtime-oriented split values. Keep DB_PASSWORD sourced from GSM-backed
# secret delivery and avoid committing real credentials in repo-managed config.
DB_HOST=localhost:5432
DB_NAME=platform_blueprint
DB_USER=postgres
DB_PASSWORD=
WORKER_TICK_INTERVAL=30s
OTEL_MODE=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
